    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test --test-concurrency=1 \"test/*.test.mjs\"",
    "test:browser": "npm run build && playwright test",
    "prepack": "npm run build"
  },
