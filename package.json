{
  "name": "rshono-monorepo",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "author": "Lasse <lasse@lassetange.com> (https://www.lassetange.com)",
  "license": "ISC",
  "keywords": [
    "react",
    "nextjs",
    "tanstack"
  ],
  "bugs": {
    "url": "https://github.com/rshono/rshono/issues"
  },
  "homepage": "https://github.com/rshono/rshono",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "pnpm --filter @rshono/core dev",
    "build": "pnpm --filter \"./apps/*\" build",
    "testbed:dev": "pnpm --filter testbed dev",
    "version:set": "pnpm -r --filter \"@rshono/core\" --filter \"@rshono/create\" exec npm version --no-git-tag-version",
    "release": "echo 'Releases publish from a v* tag — see CONTRIBUTING.md. To cut one: pnpm version:set <version> && git commit -am \"Release v<version>\" && git tag v<version> && git push --follow-tags' && exit 1",
    "clean": "rm -rf packages/*/dist packages/*/node_modules apps/*/node_modules node_modules",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "uncomment": "prettier --plugin=prettier-plugin-uncomment --write ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "prettier": "^3.9.1",
    "prettier-plugin-uncomment": "^1.0.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.65.0"
  }
}
