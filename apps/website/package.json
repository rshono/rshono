{
  "name": "website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.1.0"
  },
  "scripts": {
    "dev": "rshono dev",
    "build": "pnpm --filter @rshono/core build && rshono build",
    "typecheck": "tsc --noEmit",
    "start": "rshono start",
    "deploy": "pnpm run build && wrangler deploy",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@rshono/core": "workspace:*",
    "@shikijs/langs": "^4.4.3",
    "@shikijs/themes": "^4.4.3",
    "gray-matter": "^4.0.3",
    "hono": "^4.13.7",
    "markdown-it": "^15.0.2",
    "markdown-it-anchor": "^10.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shiki": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.2.18",
    "postcss": "^8.5.28",
    "postcss-loader": "^8.2.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "wrangler": "^4.136.0"
  }
}
